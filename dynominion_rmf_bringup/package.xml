<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dynominion_rmf_bringup</name>
  <version>0.0.0</version>
  <description>Top level bringup for dynominion RMF fleet</description>
  <maintainer email="guruprasath.a003@gmail.com">jazzy</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rmf_traffic_ros2</depend>
  <depend>rmf_task_ros2</depend>
  <depend>rmf_fleet_adapter</depend>
  <depend>dynominion_fleet_adapter</depend>
  <depend>dynominion_rmf_gazebo</depend>
  <depend>dynominion_rmf_navigation</depend>
  
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rmf_building_map_tools</exec_depend>
  <exec_depend>rmf_visualization</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
